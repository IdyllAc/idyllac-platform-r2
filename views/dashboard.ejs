</section>

<br><br>



  <!-- Server-side rendered logout link/button -->
<% if (user) { %> 
<a href="/logout" class="btn btn-logout">
Log out
</a>
<% } %>
</div>


  <!-- <footer>
    <span class="nowrap">&copy;<time id="year"></time> IdyllAc</span>
  </footer> -->


  <!-- ✅ Inject server-side user object. Place your script *at the very bottom*, right before </body> -->
 <script id="user-data" type="application/json">
  <%- JSON.stringify(user || {}) %>
</script>

<!-- ✅ Place your JS file LAST -->
<script src="/js/dashboard.js"></script>

</body>
</html>





 
