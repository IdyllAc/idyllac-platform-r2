  <div class="cards-header">
    <h2>💳 My Banking Cards</h2>

    <button id="createCardBtn" class="btn btn-primary">
      + Create Card
    </button>
  </div>

  <div class="cards-slider">
    <div class="cards-track" id="cardsTrack">
      <!-- Cards injected dynamically -->
    </div>
  </div>


  <div class="bank-card-wrapper">
    <!-- <img src="./../img/400PngdpiLogoCroppedBW.png" alt="" width=""> -->
    <div class="bank-card">
  
      <!-- FRONT -->
