<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
   <title>User Dashboard</title>
   <link rel="stylesheet" href="/CSS/dashboard.css">
   <link rel="stylesheet" href="/CSS/card1.css">
   <link
rel="stylesheet"
href="/node_modules/@fortawesome/fontawesome-free/css/all.min.css">
  <!-- <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" 
    integrity="sha512-SnH5WK+bZxgPHs44uWIX+LLJAJ9/2PkPKZ5QiAj6Ta86w+fsb2TkcmfRyVX3pBnMFcV7oQPJkl9QevSCWr3W6A==" 
    crossorigin="anonymous" referrerpolicy="no-referrer"/>  -->

</head>
<body> 
    <!-- 🔄 Spinner (initially visible) -->
    <div id="loading-spinner">
      <div class="spinner">
      </div>
    </div>

     <!-- ✅ Dashboard Content -->
    <!-- <p style="margin-top: 12px; color: white;">Loading your dashboard...</p> -->

  <!-- ✅ Actual dashboard (hidden until data loads) -->
  <div id="dashboard-content">
    <div id="user-info"></div>
    <h1 class="text-3xl font-bold mb-2">👋 Welcome back, <%= user ? user.name : 'Guest' %>!</h1>
 <!-- <p class="text-lg text-gray-600">Your personal dashboard is ready.</p> -->
  <p class="mt-2">You’re now securely logged in.</p>
      <p>We’re glad to see you. Let’s get started 🚀</p>
  <br>

  <p>Your profile completion: 
    <strong><%= typeof progress === 'number' ? progress : 0 %>%</strong>
  </p>

  <p><a href="/protect/personal_info" class="btn btn-primary">🚀 Start Registration</a></p>
  
  <!-- Progress bar -->
<div class="progress-bar-bg" aria-hidden="true">
  <!-- <p>DEBUG: "<%= progress %>"</p> -->
        
     <div 
     class="progress-bar-fill"
     data-progress="<%= typeof progress === 'number' ? progress : 0 %>">
      </div> 
</div>

  <!-- Registration flow buttons -->
  <div class="registration-actions">
    <% if (progress < 100) { %>
      <% let nextStep = '/protect/personal_info'; %>
      <% if (progress >= 25 && progress < 50) nextStep = '/protect/upload/document'; %>
      <% if (progress >= 50 && progress < 75) nextStep = '/protect/upload/selfie'; %>
      <% if (progress >= 75 && progress < 100) nextStep = '/protect/completed'; %>

      <a href="<%= nextStep %>" 
        class="btn btn-primary">
        <%= progress === 0 ? '🚀 Start Registration' : '➡ Continue Registration' %>
       </a> 

      <a href="/protect/completed" class="btn btn-outline">
         Review Progress
      </a>
    <% } else { %>
      <a href="/protect/completed" class="btn btn-success">
         ✅ View Completed Profile
        </a>
    <% } %>
  </div>

  <section id="dashboard-main">
    <a href="/profile/profile" class="btn btn-primary">
      Go to Profile
    </a>
    <a href="/profile/settings" class="btn btn-primary">
      Go to Settings
    </a>
  </section>

      <br>

      <section class="documents-section">
   <h3>Verification Documents</h3>

  <% if (user.verification_status === 'pending') { %>

    <div class="verification-pending">
          <p class="badge pending">🟡 Identity Verification In Review</p> 
     <!-- <p class="badge warning">⏳ Pending Review</p> -->

      <p class="pending-note">
        Your submitted identity documents are currently under compliance review.
      </p>

      <p class="pending-subnote">
        You will be notified once the verification process has been completed.
      </p>

    </div>
  
  <% } else if (user.verification_status === 'approved') { %>
  
    <div class="verification-locked">
      <p class="badge ok">✅ Identity Verified</p>  
      
      <p class="locked-note">
        👍 Your identity documents have been successfully reviewed and approved by our compliance team.
      </p>

      <p class="locked-success">
        🔒 Approved documents are now locked and can no longer be modified.
      </p>

      <p class="locked-subnote">
        Your account is now eligible to proceed to the next stage of onboarding.
      </p>

      <p class="locked-subnote">
        If any additional verification is required, you will be notified by email.
      </p>

    </div>
  
  <% } else if (user.verification_status === 'rejected') { %>
  
    <div class="verification-rejected">
      <p class="badge error">❌ Verification Requires Attention</p>

      <p class="rejected-note">
        One or more of your submitted documents could not be verified.
      </p>

      <p class="rejected-subnote">
        Please upload a valid document to continue.
      </p>

    </div>
  
    <a href="/protect/upload/document" class="btn btn-primary">
      ♻️ Re-upload Documents
    </a>

  <% } %>
</section>


<section id="dashboard-main"></section>


<!-- BANK CARDS -->
