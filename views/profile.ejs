<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Your Profile</title>
  <link rel="stylesheet" href="/CSS/profile.css">
  <link
rel="stylesheet"
href="/node_modules/@fortawesome/fontawesome-free/css/all.min.css">
  <!-- <script src="https://kit.fontawesome.com/cbdd759dc1.js" crossorigin="anonymous"></script> -->
</head>
<body>
  <div class="container">
    <div class="profile-card">
      <i class="fa-solid fa-user-circle"></i>
      <h2>Your Profile</h2>
      <p>Keep your profile updated. Fields with <small class="required">*</small> are required.</p>

       <form id="profile-form" method="POST" enctype="multipart/form-data">
        <!-- Unchangeable -->
       <div class="input-group">
          <label for="first_name">First Name *</label>
          <input type="text" id="first_name" name="first_name" autocomplete="off" readonly class="locked-field" />
        </div>
        <div class="input-group">
          <label for="last_name">Last Name *</label>
          <input type="text" id="last_name" name="last_name" autocomplete="off" readonly class="locked-field" /> 
        </div>
        <div class="input-group">
          <label for="date_of_birth">Date of Birth *</label>
          <input type="date" id="date_of_birth" name="date_of_birth" autocomplete="off" readonly class="locked-field" />
        </div>

        <!-- Editable -->
        <div class="input-group">
          <label for="gender">Gender *</label>
          <select id="gender" name="gender" required>
            <option value="">Select Gender</option>
            <option>Monsieur</option>
            <option>Madame</option>
           <option>Other</option>
          </select>
        </div>

        <div class="input-group">
          <label for="nationality">Nationality *</label>
          <input type="text" id="nationality" name="nationality" autocomplete="on" placeholder="nationality" required />
        </div>
        <div class="input-group">
          <label for="occupation">Occupation *</label>
          <input type="text" id="occupation" name="occupation" autocomplete="on" placeholder="secter of work" required />
        </div>
        <div class="input-group">
          <label for="phone">Phone (Primary Mobile) *</label>
          <input type="tel" id="phone" name="phone" autocomplete="on" placeholder="+1 (234) 567890" required />
        </div>

        <div class="input-group">
          <label for="phone_alt">Secondary Mobile (Optional)</label>
          <input type="tel" id="phone_alt" name="phone_alt" placeholder="+1 (987) 654321" />
        </div>

        <div class="input-group">
          <label for="telephone_fixe">Telephone Fixe (Optional)</label>
          <input type="tel" id="telephone_fixe" name="telephone_fixe" placeholder="+1 (111) 222333" />
        </div>

        <div class="input-group">
          <label for="country_of_birth">Country of Birth *</label>
          <input type="text" id="country_of_birth" name="country_of_birth" placeholder="Enter your country of birth" required />
        </div>

        <div class="input-group">
          <label for="country_of_living">Country of Living *</label>
          <input type="text" id="country_of_living" name="country_of_living" placeholder="Enter your country of living" required />
        </div>

        <div class="input-group">
          <label for="state">State / Province / Town / Village <span class="optional">(optional)</span></label>
          <input type="text" id="state" name="state" placeholder="Enter your state or local area" />
        </div>

        <div class="input-group">
          <label for="city">City *</label>
          <input type="text" id="city" name="city" placeholder="Enter your city" required />
        </div>

        <div class="input-group">
          <label for="address">Address *</label>
          <input type="text" id="address" name="address" autocomplete="on" placeholder="Street / House number" required />
        </div>

        <div class="input-group">
          <label for="language_preference">Preferred Language for Contact *</label>
          <select id="language_preference" name="language_preference" required>
            <option value="">Select language</option>
            <option>English</option>
            <option>French</option>
            <option>Arabic</option>
            <option>Spanish</option>
            <option>Other</option>
        </select>
        </div>

        <div class="input-group">
          <label for="profile_photo">Profile Photo</label>
            <input type="file" id="profile_photo" name="profile_photo" accept="image/*" />
           

        <div id="photo-preview-container" style="margin-top: 10px;">
           <img 
           id="photo-preview" 
           src="/uploads/default-avatar.png" 
           alt="Profile photo preview"  width="100" height="100" 
           style="border-radius: 50%; display:block; margin:auto;" 
           />
        </div>

        <button type="submit" class="btn btn-primary">Save Changes</button>
        <a href="/dashboard" class="btn btn-outline">← Back</a>
      </form>
    </div>
  </div>

  <footer>
    <span>&copy; <time id="year"></time> IdyllAc</span>
  </footer>

  <script src="/js/profile.js"></script>
</body>
</html>





 
 
 
 
 
 